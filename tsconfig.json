{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "module": "preserve",
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "outDir": "./dist",
        "moduleResolution": "bundler",
        "baseUrl": "./",
        "rootDir": "./",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react",
        "incremental": true,
        "noImplicitAny": false,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
    "exclude": ["node_modules"]
}
