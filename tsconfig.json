{
    "compilerOptions": {
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "esModuleInterop": true,
        "baseUrl": "./",
        "rootDir": "./",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "incremental": true,
        "noImplicitAny": false,
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "outDir": "./dist",
        "declaration": true,
        "noEmit": true,
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "./dist"
    ]
}
