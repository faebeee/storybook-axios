{
  "name": "storybook-axios",
  "version": "2.0.1-10",
  "type": "module",
  "description": "Axios inspection for storybook",
  "keywords": [
    "storybook",
    "axios",
    "network",
    "documentation",
    "addon",
    "storybook-addons"
  ],
  "exports": {
    "./manager": "./src/manager.ts",
    "./decorator": "./src/decorator.ts"
  },
  "scripts": {
    "lint": "eslint ./src",
    "format": "eslint ./src --fix",
    "build": "npx tsc",
    "dev": "npx tsc --watch",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit",
    "build-storybook": "storybook build"
  },
  "author": "faebeee",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/faebeee/storybook-axios"
  },
  "engines": {
    "node": "22"
  },
  "peerDependencies": {
    "axios": "^1.12.2",
    "react": ">=18",
    "react-dom": ">=18",
    "storybook": "^9.1.16"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.16",
    "axios-mock-adapter": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.552.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@storybook/addon-links": "^9.1.16",
    "@storybook/builder-vite": "^9.1.16",
    "@storybook/react": "^9.1.16",
    "@storybook/react-vite": "^9.1.16",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/react": ">=18",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^9.1.16",
    "storybook": "^9.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.2.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "storybook": {
    "displayName": "storybook-axios",
    "unsupportedFrameworks": [],
    "supportedFrameworks": [
      "React",
      "Vue",
      "Angular"
    ]
  }
