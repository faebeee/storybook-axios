{
  "name": "storybook-axios",
  "version": "2.0.1-9",
  "type": "module",
  "description": "Axios inspection for storybook",
  "keywords": [
    "storybook",
    "axios",
    "network",
    "documentation",
    "addon",
    "storybook-addons"
  ],
  "exports": {
    "./manager": "./src/manager.tsx",
    "./decorator": "./src/decorator.ts"
  },
  "scripts": {
    "lint": "eslint ./src",
    "format": "eslint ./src --fix",
    "dev": "npx tsc --watch",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit",
    "build-storybook": "build-storybook -o docs"
  },
  "author": "faebeee",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/faebeee/storybook-axios"
  },
  "engines": {
    "node": "16"
  },
  "peerDependencies": {
    "axios": "^1.12.2",
    "react": "^17.0.1",
    "react-dom": "^17.0.1"
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.0",
    "antd": "^5.10.3",
    "axios-mock-adapter": "^2.1.0"
  },
  "devDependencies": {
    "storybook": "^9.1.0",
    "eslint": "^9.38.0",
    "@eslint/js": "^9.38.0",
    "@storybook/addon-links": "^9.1.12",
    "@storybook/react": "^9.1.12",
    "@types/react": "^17.0.75",
    "typescript": "^4.9.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "typescript-eslint": "^8.46.2",
    "@stylistic/eslint-plugin": "^5.5.0",
    "eslint-plugin-storybook": "9.1.13",
    "@storybook/react-vite": "^9.1.16"
  },
  "storybook": {
    "displayName": "storybook-axios",
    "unsupportedFrameworks": [],
    "supportedFrameworks": [
      "React",
      "Vue",
      "Angular"
    ]
  }
}
