{
  "name": "storybook-axios",
  "version": "2.0.1-0",
  "description": "Axios inspection for storybook",
  "keywords": [
    "storybook",
    "axios",
    "network",
    "documentation",
    "addon",
    "storybook-addons"
  ],
  "exports": {
    "./manager": "./src/manager.tsx",
    "./decorator": "./src/decorator.ts"
  },
  "scripts": {
    "lint": "biome lint",
    "format": "biome format",
    "dev": "npx tsc --watch",
    "storybook": "start-storybook -p 6006",
    "typecheck": "tsc --noEmit",
    "build-storybook": "build-storybook -o docs"
  },
  "author": "faebeee",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/faebeee/storybook-axios"
  },
  "engines": {
    "node": "16"
  },
  "peerDependencies": {
    "axios": "^1.12.2",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "storybook": "^9.1.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.0",
    "@storybook/components": "^9.0.0-alpha.1",
    "antd": "^5.10.3"
  },
  "devDependencies": {
    "@babel/core": "^7.12.10",
    "@biomejs/biome": "2.1.3",
    "@storybook/addon-actions": "^9.0.8",
    "@storybook/addon-links": "^9.1.12",
    "@storybook/react": "^9.1.12",
    "@types/react": "^17.0.75",
    "babel-loader": "^8.2.2",
    "typescript": "^4.9.5"
  },
  "storybook": {
    "displayName": "storybook-axios",
    "unsupportedFrameworks": [],
    "supportedFrameworks": [
      "React",
      "Vue",
      "Angular"
    ]
  }
}
