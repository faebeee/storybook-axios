{
    "$schema": "https://biomejs.dev/schemas/2.1.3/schema.json",
    "vcs": {
        "enabled": false,
        "clientKind": "git",
        "useIgnoreFile": false
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "src/**/*.ts",
            "src/**/*.tsx",
            "stories/**/*.ts",
            "stories/**/*.tsx",
            "./register.tsx",
            "utils/**/*.ts"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentWidth": 4,
        "lineWidth": 100,
        "indentStyle": "space"
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "correctness": {
                "noUnusedVariables": "error",
                "noUnusedImports": "error",
                "noUnusedFunctionParameters": "error"
            },
            "style": {
                "useImportType": "error",
                "noUnusedTemplateLiteral": "error"
            }
        }
    },
    "javascript": {
        "jsxRuntime": "reactClassic",
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
